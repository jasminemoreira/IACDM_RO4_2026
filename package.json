{
  "name": "hanzi-pwa-w2",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build": "tsc -p tsconfig.browser.json && node build.ts",
    "check": "tsc -p tsconfig.browser.json --noEmit && tsc -p tsconfig.node.json",
    "serve": "node src/server/main.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "prebuild": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
